# Configuración de Google Sheets
# Completa los valores según tus sheets

# IDs de los spreadsheets (encuéntralos en la URL del sheet)
# Ejemplo: https://docs.google.com/spreadsheets/d/[ESTE_ES_EL_ID]/edit
SOURCE_SHEET_ID=1RkbgAXnR9bQQSRMUxvXbm_r3m1bnzqIN
DESTINATION_SHEET_ID=1ioSGAiS7zsrDs7d3w0IE7JsLInNJjXagB9AdyDN2x14
#1lwSU9CV4M5hZAHGbqzpMPFuYHsvW0cxl0LTf9L57QXI REAL

# Rangos de datos (ej: A1:Z100, A:Z, etc.)
# SOURCE_RANGE: Rango a leer del sheet origen
# DESTINATION_RANGE: Rango a escribir en el sheet destino
SOURCE_RANGE=D:F
DESTINATION_RANGE=A:M

# Nombres de las hojas (opcional, por defecto usa la primera hoja)
SOURCE_SHEET_NAME=Status y Solicitud RIFs
DESTINATION_SHEET_NAME=Worksheet

# Configuración de autenticación
CREDENTIALS_PATH=./credentials.json
TOKEN_PATH=./token.json
